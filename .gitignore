# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# graphify (local knowledge graph cache — not committed)
/graphify-out

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/playwright-report/
/test-results/
/playwright/.cache/
.playwright-cli/

# Superpowers brainstorming
.superpowers/

# scratch / tooling working dirs (generated, not source)
.sandcastle/
.tmp/

# scratch screenshots dropped at repo root (public/ logos are kept)
/*.png

# machine-specific Claude permissions — not shared
.claude/settings.local.json
